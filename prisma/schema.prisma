generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

enum Role {
  admin
  subAdmin
  semesterAdmin
  teacher
  student
}

enum Shift {
  first  @map("1st")
  second @map("2nd")
}

enum Section {
  A
  B
  C
  D
}

enum AttendanceStatus {
  present
  absent
}

enum MarkedBy {
  manual
  search
  self
}

enum SessionStatus {
  active
  ended
}

enum HolidayType {
  friday
  eid
  puja
  national
  semester_break
  other
}

enum InviteRole {
  subAdmin
  semesterAdmin
  teacher
}

enum PublicRole {
  student
  teacher
}

model Department {
  id             String  @id @default(uuid())
  name           String
  code           String  @unique
  technologyCode String  @default("") @map("technology_code")
  description    String?
  isActive       Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                User[]
  subjects             Subject[]
  sessions             Session[]
  attendances          Attendance[]
  adminInvites         AdminInvite[]
  studentPreApprovals  StudentPreApproval[]
  pendingRegistrations PendingRegistration[]

  @@map("departments")
}

model User {
  id                  String    @id @default(uuid())
  name                String?
  email               String    @unique
  password            String?
  role                Role
  shift               Shift?
  departmentId        String?   @map("department_id")
  departmentCode      String?   @map("department_code")
  semesters           Int[]
  semester            Int?
  section             Section?
  subjectId           String?   @map("subject_id")
  studentId           String?   @unique @map("student_id")
  mobile              String?
  createdById         String?   @map("created_by")
  isActive            Boolean   @default(true)  @map("is_active")
  isVerified          Boolean   @default(false) @map("is_verified")
  registered          Boolean   @default(true)
  regCode             String?   @map("reg_code")
  regCodeExpire       DateTime? @map("reg_code_expire")
  verificationOTP     String?   @map("verification_otp")
  verificationExpire  DateTime? @map("verification_expire")
  resetPasswordOTP    String?   @map("reset_password_otp")
  resetPasswordExpire DateTime? @map("reset_password_expire")
  loginOTP            String?   @map("login_otp")
  loginOTPExpire      DateTime? @map("login_otp_expire")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  department   Department? @relation(fields: [departmentId], references: [id])
  subject      Subject?    @relation("UserSubject", fields: [subjectId], references: [id])
  createdBy    User?       @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[]      @relation("UserCreatedBy")

  taughtSubjects      Subject[]            @relation("TeacherSubjects")
  teacherSessions     Session[]            @relation("TeacherSessions")
  substituteSessions  Session[]            @relation("SubstituteSessions")
  attendances         Attendance[]
  ignoredMisses       IgnoredMiss[]
  adminInvites        AdminInvite[]
  addedPreApprovals   StudentPreApproval[] @relation("AddedByUser")
  usedPreApprovals    StudentPreApproval[] @relation("UsedByUser")
  pendingRegistrations PendingRegistration[]

  @@index([role, departmentId, shift, semester])
  @@index([role, departmentId, shift, semester, section])
  @@index([createdAt(sort: Desc)])
  @@map("users")
}

model Subject {
  id           String  @id @default(uuid())
  name         String
  code         String
  departmentId String  @map("department_id")
  semester     Int
  section      Section
  shift        Shift
  teacherId    String? @map("teacher_id")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  department    Department    @relation(fields: [departmentId], references: [id])
  teacher       User?         @relation("TeacherSubjects", fields: [teacherId], references: [id])
  userSubject   User[]        @relation("UserSubject")
  sessions      Session[]
  attendances   Attendance[]
  ignoredMisses IgnoredMiss[]

  @@index([isActive, departmentId, shift, semester])
  @@index([teacherId])
  @@map("subjects")
}

model Session {
  id             String        @id @default(uuid())
  teacherId      String        @map("teacher_id")
  departmentId   String        @map("department_id")
  subjectId      String        @map("subject_id")
  semester       Int
  section        String
  shift          Shift?
  date           DateTime      @default(now())
  startTime      DateTime      @default(now()) @map("start_time")
  endTime        DateTime?     @map("end_time")
  status         SessionStatus @default(active)
  totalStudents  Int           @default(0) @map("total_students")
  presentCount   Int           @default(0) @map("present_count")
  isSubstitute   Boolean       @default(false) @map("is_substitute")
  substituteById String?       @map("substitute_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teacher      User       @relation("TeacherSessions", fields: [teacherId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])
  subject      Subject    @relation(fields: [subjectId], references: [id])
  substituteBy User?      @relation("SubstituteSessions", fields: [substituteById], references: [id])
  attendances  Attendance[]

  @@index([subjectId, date])
  @@index([teacherId, date(sort: Desc)])
  @@index([status, departmentId, semester, section])
  @@map("sessions")
}

model Attendance {
  id           String           @id @default(uuid())
  sessionId    String           @map("session_id")
  studentId    String           @map("student_id")
  subjectId    String           @map("subject_id")
  departmentId String           @map("department_id")
  semester     Int
  section      String
  className    String           @map("class_name")
  date         DateTime         @default(now())
  status       AttendanceStatus @default(present)
  scannedAt    DateTime?        @map("scanned_at")
  markedBy     MarkedBy         @default(manual) @map("marked_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  session    Session    @relation(fields: [sessionId], references: [id])
  student    User       @relation(fields: [studentId], references: [id])
  subject    Subject    @relation(fields: [subjectId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId, date(sort: Desc)])
  @@index([subjectId, date(sort: Desc)])
  @@map("attendances")
}

model Holiday {
  id          String      @id @default(uuid())
  title       String
  startDate   DateTime    @map("start_date")
  endDate     DateTime    @map("end_date")
  type        HolidayType @default(other)
  recurring   Boolean     @default(false)
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([startDate, endDate])
  @@map("holidays")
}

model Settings {
  id                  String @id @default(uuid())
  key                 String @unique @default("global")
  attendanceThreshold Int    @default(70) @map("attendance_threshold")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Feedback {
  id      String @id @default(uuid())
  name    String
  email   String
  message String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feedbacks")
}

model AdminInvite {
  id             String     @id @default(uuid())
  role           InviteRole
  name           String
  email          String
  departmentId   String?    @map("department_id")
  departmentCode String?    @map("department_code")
  shift          Shift?
  semester       Int?
  section        Section?
  subjectName    String?    @map("subject_name")
  subjectCode    String?    @map("subject_code")
  invitedById    String     @map("invited_by")
  code           String
  codeExpire     DateTime   @map("code_expire")
  used           Boolean    @default(false)
  usedAt         DateTime?  @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  department Department? @relation(fields: [departmentId], references: [id])
  invitedBy  User        @relation(fields: [invitedById], references: [id])

  @@index([email, role])
  @@map("admin_invites")
}

model StudentPreApproval {
  id           String    @id @default(uuid())
  roll         String    @unique
  email        String    @unique
  departmentId String    @map("department_id")
  shift        Shift
  semester     Int
  addedById    String    @map("added_by")
  code         String
  codeExpire   DateTime  @map("code_expire")
  used         Boolean   @default(false)
  usedAt       DateTime? @map("used_at")
  usedByUserId String?   @map("used_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  department Department @relation(fields: [departmentId], references: [id])
  addedBy    User       @relation("AddedByUser", fields: [addedById], references: [id])
  usedByUser User?      @relation("UsedByUser", fields: [usedByUserId], references: [id])

  @@map("student_pre_approvals")
}

model PendingRegistration {
  id              String     @id @default(uuid())
  name            String
  email           String
  password        String
  role            PublicRole
  shift           Shift?
  studentIdText   String?    @map("student_id_text")
  departmentId    String?    @map("department_id")
  semester        Int?
  section         String?
  shadowStudentId String?    @map("shadow_student_id")
  mobile          String?
  otp             String
  otpExpire       DateTime   @map("otp_expire")
  createdAt       DateTime   @default(now()) @map("created_at")

  department    Department? @relation(fields: [departmentId], references: [id])
  shadowStudent User?       @relation(fields: [shadowStudentId], references: [id])

  @@map("pending_registrations")
}

model IgnoredMiss {
  id          String   @id @default(uuid())
  subjectId   String   @map("subject_id")
  date        DateTime
  ignoredById String   @map("ignored_by")
  reason      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subject   Subject @relation(fields: [subjectId], references: [id])
  ignoredBy User    @relation(fields: [ignoredById], references: [id])

  @@unique([subjectId, date])
  @@index([date])
  @@map("ignored_misses")
}
